# Personalized Questionnaire API Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=production

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
TARGET_EMAIL=gina.pommerenke@biovariance.com

# Partner API Configuration (to be provided by client)
PARTNER_API_ENDPOINT=https://partner-api.example.com/submit
PARTNER_API_KEY=your-partner-api-key

# Data Storage Configuration
DATA_DIR=./data
CSV_PATH=./data/questionnaire-responses.csv

# Shopify Configuration
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_SHOP_NAME=your-shop-name.myshopify.com

# Optional: SendGrid (alternative to SMTP)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Optional: AWS S3 for backup storage
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=eu-central-1

# Optional: Database Configuration (for future expansion)
# DATABASE_URL=postgresql://user:password@localhost:5432/personalized_db

# Security
# JWT_SECRET=your-jwt-secret-key-here
# API_SECRET_KEY=your-api-secret-key

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/api.log
