# ===========================================
# ESSENZA BACKEND - Environment Configuration
# ===========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# API Security
API_SECRET_KEY=your-secret-api-key-here
JWT_SECRET=your-jwt-secret-here

# Shopify Configuration
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_ACCESS_TOKEN=your-shopify-access-token
SHOPIFY_API_VERSION=2024-01

# Shopify Webhook Secret (for verifying webhook requests)
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# MongoDB Configuration (optional - for persistent storage)
MONGODB_URI=mongodb://localhost:27017/essenza
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/essenza

# Email Configuration (for confirmation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=info@bio-eta.de
EMAIL_FROM_NAME=Bio-eta Essenza

# CORS Configuration
ALLOWED_ORIGINS=https://your-shop.myshopify.com,https://your-shop.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
